# Alles optional. Kopiere diese Datei nach ".env" neben docker-compose.yml.
TZ=Europe/Berlin
PORT=8088
# Zugangs-Passwort für die App (leer = kein Passwort, nur im Heimnetz sinnvoll)
APP_PASSWORD=
# Name der App (erscheint oben links)
APP_NAME=Lernhafen
# Start-Profil für die Einrichtung: allgemein, schule, duale-ausbildung, studium, pflege oder ergotherapie
PROFILE=allgemein
# Uhrzeit (Stunde) für den täglichen Stundenplan-Abgleich
SYNC_HOUR=6
# Sprachen der Texterkennung (Tesseract), z. B. deu+eng
OCR_LANG=deu+eng

# --- Google (nur nötig, wenn das Image keine Google-Zugangsdaten enthält) ---
# Zugangsdaten einer eigenen Google-App vom Typ „Webanwendung“, siehe README, Abschnitt „Google einrichten“
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Eigene IP (nur für docker-compose.eigene-ip.yml) ---
# Netzwerk-Anschluss des NAS (meist eth0), dein Heimnetz, dein Router und eine freie Adresse für Lernhafen
LAN_PARENT=eth0
LAN_SUBNET=192.168.1.0/24
LAN_GATEWAY=192.168.1.1
LAN_IP=192.168.1.50
