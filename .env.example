# Alles optional. Kopiere diese Datei nach ".env" neben docker-compose.yml.
TZ=Europe/Berlin
PORT=8088
# Zugangs-Passwort für die App (leer = kein Passwort, nur im Heimnetz sinnvoll)
APP_PASSWORD=
# Name der App (erscheint oben links)
APP_NAME=Lernhafen
# Start-Profil für die Einrichtung: allgemein, schule, duale-ausbildung, studium, pflege oder ergotherapie
PROFILE=allgemein
# Uhrzeit (Stunde) für den täglichen Stundenplan-Abgleich
SYNC_HOUR=6
# Sprachen der Texterkennung (Tesseract), z. B. deu+eng
OCR_LANG=deu+eng

# --- Google Drive (nur nötig, wenn das Image keine Google-Zugangsdaten enthält) ---
# Client vom Typ „Fernseher und Geräte mit begrenzter Eingabe“, siehe README, Abschnitt „Google Drive“
# Alternativ trägst du beides in der App ein (Mehr → Verbindungen → Google Drive)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Abgleich-Takt in Minuten (zusätzlich zum Abgleich kurz nach jeder Änderung)
GDRIVE_SYNC_MINUTES=30

# --- Eigene IP (nur für docker-compose.eigene-ip.yml) ---
# Netzwerk-Anschluss des NAS (meist eth0), dein Heimnetz, dein Router und eine freie Adresse für Lernhafen
LAN_PARENT=eth0
LAN_SUBNET=192.168.1.0/24
LAN_GATEWAY=192.168.1.1
LAN_IP=192.168.1.50

# --- Sicherung ---
# Nächtliche Sicherung (Standard: data/backups). Zeige auf eine andere Platte, z. B. /backups mit passendem Volume
BACKUP_DIR=
BACKUP_KEEP=7
